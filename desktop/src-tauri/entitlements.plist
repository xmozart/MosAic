<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hardened runtime (notarization), not App Sandbox (ADR 0060). The bundled Python runs
     ctypes/libffi closures and ONNX Runtime, which need writable-executable memory; no
     other exception is taken (ADR 0061). -->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
</dict>
</plist>
